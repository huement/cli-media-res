#!/usr/bin/env bash

# Manipulate Y, U, and V bitplanes to make colorful creations

# Parameters:
# $1: Input File
# $2: Y bitplane
# $3: U bitplane
# $4: V bitplane

_usage(){
cat <<EOF
$(basename "${0}")
  Usage
   $(basename "${0}") [OPTIONS] INPUT_FILE Y_BITPLANE U_BITPLANE V_BITPLANE
  Options
   -h  display this help

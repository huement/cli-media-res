#!/usr/bin/env bash

# 1. Source the bash-args library
source "$(dirname "$0")/../bash-args.sh"

# --------------------------------------------------------
# CONFIGURATION
# --------------------------------------------------------
DESCRIPTION="Smart Video Optimizer: Upscales low-res, preserves high-res, adds effects."

KEYWORDS=(
    "--input|-i;string"
